import os
from datetime import datetime

file_name = "evidence.txt"

info = os.stat(file_name)

print("===== FILE METADATA =====")
print("File Name         :", file_name)
print("File Size         :", info.st_size, "bytes")
print("Creation Time     :", datetime.fromtimestamp(info.st_ctime))
print("Modification Time :", datetime.fromtimestamp(info.st_mtime))
print("Access Time       :", datetime.fromtimestamp(info.st_atime))

